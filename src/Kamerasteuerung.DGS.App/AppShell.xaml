<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Kamerasteuerung.DGS.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Kamerasteuerung.DGS.App.Views"
    Title="Kamerasteuerung DGS">
    <TabBar>
        <ShellContent
            Title="Start"
            ContentTemplate="{DataTemplate views:HomePage}" />
        <ShellContent
            Title="Layout"
            ContentTemplate="{DataTemplate views:LayoutDesignerPage}" />
        <ShellContent
            Title="Live"
            ContentTemplate="{DataTemplate views:LiveControlPage}" />
        <ShellContent
            Title="Teilnehmer"
            ContentTemplate="{DataTemplate views:ParticipantsPage}" />
        <ShellContent
            Title="Einstellungen"
            ContentTemplate="{DataTemplate views:SettingsPage}" />
    </TabBar>
</Shell>
