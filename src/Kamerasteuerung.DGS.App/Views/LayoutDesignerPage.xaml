<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Kamerasteuerung.DGS.App.Views.LayoutDesignerPage"
    Title="Layout">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="Layout-Designer" FontSize="24" FontAttributes="Bold" />
            <Label Text="Grundansicht: Layoutdaten + Arbeitsfläche (noch ohne Editor-Funktionen)." />

            <Frame Padding="12" BorderColor="#CCCCCC">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Aktuelles Layout" FontAttributes="Bold" />
                    <Label x:Name="LayoutNameLabel" Text="Kein Layout geladen" />
                    <Label x:Name="LayoutPathLabel" Text="" FontSize="12" TextColor="Gray" />
                    <Label x:Name="StatusLabel" Text="" FontSize="12" TextColor="Gray" />

                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Neues Layout" Clicked="OnNewLayoutClicked" />
                        <Button Text="Layout öffnen" Clicked="OnOpenLayoutClicked" />
                        <Button Text="Layout speichern" Clicked="OnSaveLayoutClicked" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <Frame x:Name="NoLayoutFrame" Padding="12" BorderColor="#FFB74D" BackgroundColor="#FFF3E0" IsVisible="False">
                <Label Text="Kein Layout geladen. Bitte 'Neues Layout' erstellen oder 'Layout öffnen' verwenden." />
            </Frame>

            <Frame x:Name="LayoutSummaryFrame" Padding="12" BorderColor="#CCCCCC" IsVisible="False">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Zusammenfassung" FontAttributes="Bold" />
                    <Label x:Name="CanvasSizeLabel" Text="" />
                    <Label x:Name="CountsLabel" Text="" />
                </VerticalStackLayout>
            </Frame>

            <Frame x:Name="BlocksFrame" Padding="12" BorderColor="#CCCCCC" IsVisible="False">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Blöcke" FontAttributes="Bold" VerticalOptions="Center" />
                        <Button Text="Block hinzufügen" Clicked="OnAddBlockClicked" />
                        <Button Text="Block löschen" Clicked="OnDeleteBlockClicked" />
                        <Button Text="Sitze erzeugen" Clicked="OnGenerateSeatsClicked" />
                    </HorizontalStackLayout>

                    <Label x:Name="SeatsSummaryLabel" Text="" FontSize="12" TextColor="Gray" />

                    <CollectionView x:Name="BlocksCollectionView" SelectionMode="Single" SelectionChanged="OnBlockSelectionChanged">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="6" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" />
                                    <Label Grid.Row="1" Text="{Binding Details}" FontSize="12" TextColor="Gray" />
                                    <Label Grid.Column="1" Text="{Binding SelectedMarker}" FontSize="12" TextColor="Blue" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <Frame x:Name="WorkAreaFrame" Padding="12" BorderColor="#2196F3" IsVisible="False">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Arbeitsfläche" FontAttributes="Bold" />
                    <Label x:Name="WorkAreaScaleLabel" Text="" FontSize="12" TextColor="Gray" />

                    <ScrollView Orientation="Both">
                        <Grid>
                            <Border x:Name="WorkAreaBorder"
                                    Stroke="#1976D2"
                                    StrokeThickness="2"
                                    Background="#E3F2FD"
                                    WidthRequest="400"
                                    HeightRequest="260" />
                            <AbsoluteLayout x:Name="BlocksOverlay"
                                            WidthRequest="400"
                                            HeightRequest="260" />
                        </Grid>
                    </ScrollView>
                </VerticalStackLayout>
            </Frame>

            <Label Text="Geplante nächste Schritte:" FontAttributes="Bold" />
            <Label Text="• freie Fläche mit skalierbarer Größe" />
            <Label Text="• Kamera zuerst wählen, dann Plätze setzen" />
            <Label Text="• Plätze zu Blöcken gruppieren" />
            <Label Text="• Blöcke drehen" />
            <Label Text="• Layout als Datei speichern und laden" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
